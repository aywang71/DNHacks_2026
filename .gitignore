# Local credentials and language/tooling state
.env
.env.*
!.env.example
.venv/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.DS_Store

# JavaScript build/install output (all workspaces)
node_modules/
dist/
coverage/
*.tsbuildinfo

# Reproducible local process output
*.stdout.log
*.stderr.log

# Legacy corpus expansion and locally derived tables
data/raw/*.csv
data/derived/*.parquet

# Acquisition, normalization, and replay outputs are intentionally local. The
# final public archive retains only the lightweight, browser-facing demo data.
/data/bronze/
/data/silver/
/data/logs/
/code/frontend/public/data/presence/

# Generated experiments, temporary research captures, and Slidev render passes.
/output/
/tmp/
/presentation/rendered/
/ideas/*.pdf

# iCloud Desktop-sync conflict copies ("name 2.ext"). The repo lives under
# ~/Desktop, which iCloud syncs; it regenerates these on every conflict.
* [0-9].*
* [0-9]
